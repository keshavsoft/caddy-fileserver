{
  "name": "caddy-fileserver",
  "version": "1.0.0",
  "description": "Automate Ubuntu filesystem document roots, starter templates, and Caddy file_server routes for zero-configuration static site hosting.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./v1": "./src/v1/index.js",
    "./cli": "./src/cli.js"
  },
  "bin": {
    "caddy-fileserver": "bin/index.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/index.js",
    "cli": "node bin/index.js",
    "test": "node --test"
  },
  "keywords": [
    "caddy",
    "caddy-server",
    "file-server",
    "static-site",
    "ubuntu",
    "spa",
    "keshavsoft",
    "vps",
    "hosting"
  ],
  "author": "KeshavSoft",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/caddy-fileserver.git"
  },
  "bugs": {
    "url": "https://github.com/keshavsoft/caddy-fileserver/issues"
  },
  "homepage": "https://keshavsoft.github.io/caddy-fileserver/",
  "engines": {
    "node": ">=18.0.0"
  }
}
